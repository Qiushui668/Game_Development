# 依赖与构建产物
node_modules/
dist/
dist-ssr/
*.local

# Python
.venv/
__pycache__/
*.py[cod]
.pytest_cache/

# 编辑器与系统
.vscode/*
!.vscode/extensions.json
.idea/
.DS_Store
Thumbs.db

# 日志与临时
logs/
*.log
npm-debug.log*

# 性能探针临时产物
tools/perf_m1.png
tools/perf_m1.json

# 本地密钥 / 环境变量（模板 .env.example 要保留）
.env
.env.local
!.env.example

# 隧道客户端（50MB+ 的单文件可执行，跟着项目走但不入库）
cloudflared.exe

# 具名隧道的凭据与配置（含 UUID / 证书，敏感，不入库；模板要保留）
cloudflared/config.yml
cloudflared/*.json
*.pem
!cloudflared/config.example.yml
